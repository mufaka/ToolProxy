{
  "McpServer": {
    "Host": "localhost",
    "Port": 3030,
    "IdleTimeoutMinutes": 120,
    "MaxIdleSessions": 100000,
    "Stateless": false
  },
  "McpServers": [
    {
      "Name": "context7",
      "Description": "Context7 Up To Date library documentation",
      "Transport": "stdio",
      "Command": "cmd.exe",
      "Args": [ "/c", "npx", "-y", "@upstash/context7-mcp@latest" ],
      "Enabled": true,
      "Tools": []
    },
    {
      "Name": "serena",
      "Description": "Uses the language server protocol to find definitions, references, and modify function bodies of code.",
      "Transport": "stdio",
      "Command": "uvx",
      "Args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "desktop-app"
      ],
      "Enabled": true,
      "Tools": []
    },
    {
      "Name": "srclight",
      "Description": "srcLight Code Index Server",
      "Transport": "http",
      "Url": "http://127.0.0.1:8742/sse",
      "Enabled": true,
      "Tools": []
    },
    {
      "Name": "teamware",
      "Description": "TeamWare Project Management",
      "Transport": "http",
      "Url": "<URL TO TEAMWARE INSTANCE>",
      "Headers": {
        "Authorization": "Bearer <TEAMWARE PAT>"
      },
      "Enabled": true,
      "Tools": []
    },
    {
      "Name": "ms-docs",
      "Description": "Official Microsoft and Azure documentation lookup via Microsoft Learn — search docs, fetch full pages as markdown, find code samples.",
      "Transport": "http",
      "Url": "https://learn.microsoft.com/api/mcp",
      "Enabled": true,
      "Tools": []
    }
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}